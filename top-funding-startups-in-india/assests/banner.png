from PIL import Image, ImageDraw, ImageFont
import os

# Create assets folder if it doesn't exist
os.makedirs("assets", exist_ok=True)

# Banner dimensions
width = 1200
height = 300

# Create blue background
image = Image.new(
    "RGB",
    (width, height),
    (25, 118, 210)  # Blue color
)

draw = ImageDraw.Draw(image)

# Text content
title = "🚀 Top Funding Startups in India"
subtitle = "Interactive Startup Funding Analysis Dashboard"

# Load fonts
try:
    title_font = ImageFont.truetype("arial.ttf", 58)
    subtitle_font = ImageFont.truetype("arial.ttf", 28)
except:
    title_font = ImageFont.load_default()
    subtitle_font = ImageFont.load_default()

# Calculate title position
title_bbox = draw.textbbox(
    (0, 0),
    title,
    font=title_font
)
title_width = title_bbox[2] - title_bbox[0]

# Calculate subtitle position
subtitle_bbox = draw.textbbox(
    (0, 0),
    subtitle,
    font=subtitle_font
)
subtitle_width = subtitle_bbox[2] - subtitle_bbox[0]

# Draw title (centered)
draw.text(
    ((width - title_width) // 2, 70),
    title,
    fill="white",
    font=title_font
)

# Draw subtitle (centered)
draw.text(
    ((width - subtitle_width) // 2, 160),
    subtitle,
    fill="white",
    font=subtitle_font
)

# Optional divider line
draw.line(
    [(150, 145), (1050, 145)],
    fill="white",
    width=2
)

# Save image
image.save("assets/banner.png")

print("✅ assets/banner.png created successfully!")
Install Pillow
pip install pillow
Run the script
python create_banner.py
Display in Streamlit
import streamlit as st

st.image(
    "assets/banner.png",
    use_container_width=True
)

This creates a 1200×300 blue banner with a centered title, centered subtitle, and a divider line for a cleaner dashboard appearance.
